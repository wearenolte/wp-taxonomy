{
  "name": "moxie-lean/wp-taxonomy",
  "description": "wp-taxonomy",
  "keywords": [
    "wordpress",
    "taxonomies"
  ],
  "homepage": "https://github.com/wearenolte/wp-taxonomy",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Moxie Developers",
      "email": "developer@getmoxied.net"
    }
  ],
  "require": {
    "php": ">=7.4 || 8.0"
  },
  "autoload": {
    "psr-4": {
      "Lean\\": "src/"
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.7.2",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "scripts": {
    "installSniffer": [
      "./vendor/bin/phpcs --config-set installed_paths vendor/wp-coding-standards/wpcs/,vendor/phpcsstandards/phpcsutils/,vendor/phpcsstandards/phpcsextra/",
      "./vendor/bin/phpcs --config-set default_standard ./codesniffer.ruleset.xml",
      "./vendor/bin/phpcs --config-set show_progress 0",
      "./vendor/bin/phpcs --config-set colors 1"
    ],
    "post-install-cmd": [
      "@installSniffer"
    ],
    "post-update-cmd": [
      "@installSniffer"
    ],
    "test": [
      "echo \"Running WordPressCS checks...\"",
      "./vendor/bin/phpcs -s src",
      "echo \"WordPressCS checks complete.\""
    ]
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
